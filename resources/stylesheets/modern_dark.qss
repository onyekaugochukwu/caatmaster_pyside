/*
 * CAATmaster Modern Dark Theme
 * Inspired by Tailwind CSS + shadcn/ui design system
 * Color palette: Zinc/Slate tones with blue accents
 */

/* ==========================================================================
   CSS CUSTOM PROPERTIES (Design Tokens)
   ========================================================================== */
QWidget {
    /* Color Palette - Zinc */
    --color-bg-primary: #09090b;
    --color-bg-secondary: #18181b;
    --color-bg-tertiary: #27272a;
    --color-bg-hover: #3f3f46;
    --color-bg-active: #52525b;

    /* Borders */
    --color-border: #27272a;
    --color-border-hover: #3f3f46;
    --color-border-focus: #52525b;

    /* Text */
    --color-text-primary: #fafafa;
    --color-text-secondary: #a1a1aa;
    --color-text-tertiary: #71717a;
    --color-text-muted: #52525b;

    /* Accent Colors */
    --color-accent: #3b82f6;
    --color-accent-hover: #2563eb;
    --color-accent-soft: rgba(59, 130, 246, 0.1);
    --color-accent-muted: rgba(59, 130, 246, 0.2);

    /* Semantic Colors */
    --color-success: #22c55e;
    --color-success-soft: rgba(34, 197, 94, 0.1);
    --color-warning: #f59e0b;
    --color-warning-soft: rgba(245, 158, 11, 0.1);
    --color-danger: #ef4444;
    --color-danger-soft: rgba(239, 68, 68, 0.1);
    --color-info: #0ea5e9;
    --color-info-soft: rgba(14, 165, 233, 0.1);

    /* Spacing */
    --spacing-xs: 4px;
    --spacing-sm: 8px;
    --spacing-md: 12px;
    --spacing-lg: 16px;
    --spacing-xl: 24px;

    /* Border Radius */
    --radius-sm: 4px;
    --radius-md: 6px;
    --radius-lg: 8px;
    --radius-xl: 12px;

    /* Shadows */
    --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.3);
    --shadow-md: 0 4px 6px rgba(0, 0, 0, 0.3);
    --shadow-lg: 0 10px 15px rgba(0, 0, 0, 0.3);
    --shadow-xl: 0 20px 25px rgba(0, 0, 0, 0.4);

    /* Typography */
    --font-family: "Inter", "Segoe UI", "Cantarell", sans-serif;
    --font-size-xs: 11px;
    --font-size-sm: 12px;
    --font-size-md: 13px;
    --font-size-lg: 14px;
    --font-size-xl: 16px;

    /* Transitions */
    --transition-fast: 150ms ease;
    --transition-normal: 200ms ease;
}

/* ==========================================================================
   GLOBAL STYLES
   ========================================================================== */
QWidget {
    background-color: var(--color-bg-primary);
    color: var(--color-text-primary);
    font-family: var(--font-family);
    font-size: var(--font-size-md);
    border: none;
    outline: none;
}

QMainWindow, QDialog, QFrame {
    background-color: var(--color-bg-primary);
}

/* Links */
QLabel[url="true"] {
    color: var(--color-accent);
    text-decoration: underline;
}

QLabel[url="true"]:hover {
    color: var(--color-accent-hover);
}

/* ==========================================================================
   TYPOGRAPHY
   ========================================================================== */
QLabel {
    color: var(--color-text-primary);
}

QLabel#TitleLabel, .title-label {
    font-size: 24px;
    font-weight: 600;
    color: var(--color-text-primary);
}

QLabel#HeadingLabel, .heading-label {
    font-size: 18px;
    font-weight: 600;
    color: var(--color-text-primary);
}

QLabel#SubheadingLabel, .subheading-label {
    font-size: 15px;
    font-weight: 500;
    color: var(--color-text-primary);
}

QLabel#BodyLabel, .body-label {
    font-size: var(--font-size-md);
    color: var(--color-text-primary);
}

QLabel#MutedLabel, .muted-label {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
}

QLabel#CaptionLabel, .caption-label {
    font-size: var(--font-size-xs);
    color: var(--color-text-tertiary);
}

/* ==========================================================================
   BUTTONS
   ========================================================================== */

/* Base Button Style */
QPushButton {
    background-color: var(--color-bg-tertiary);
    color: var(--color-text-primary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 8px 16px;
    font-size: var(--font-size-sm);
    font-weight: 500;
    min-height: 20px;
    outline: none;
    transition: all var(--transition-fast);
}

QPushButton:hover {
    background-color: var(--color-bg-hover);
    border-color: var(--color-border-hover);
}

QPushButton:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px var(--color-accent-soft);
}

QPushButton:pressed {
    background-color: var(--color-bg-active);
    transform: translateY(1px);
}

QPushButton:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

/* Primary Button */
QPushButton#PrimaryButton, QPushButton.primary {
    background-color: var(--color-accent);
    color: white;
    border: none;
}

QPushButton#PrimaryButton:hover, QPushButton.primary:hover {
    background-color: var(--color-accent-hover);
}

QPushButton#PrimaryButton:focus, QPushButton.primary:focus {
    box-shadow: 0 0 0 3px var(--color-accent-muted);
}

/* Secondary Button */
QPushButton#SecondaryButton, QPushButton.secondary {
    background-color: transparent;
    border: 1px solid var(--color-border);
}

QPushButton#SecondaryButton:hover, QPushButton.secondary:hover {
    background-color: var(--color-bg-tertiary);
    border-color: var(--color-border-hover);
}

/* Ghost Button */
QPushButton#GhostButton, QPushButton.ghost {
    background-color: transparent;
    border: none;
    color: var(--color-text-secondary);
}

QPushButton#GhostButton:hover, QPushButton.ghost:hover {
    background-color: var(--color-bg-tertiary);
    color: var(--color-text-primary);
}

/* Danger Button */
QPushButton#DangerButton, QPushButton.danger {
    background-color: var(--color-danger);
    color: white;
    border: none;
}

QPushButton#DangerButton:hover, QPushButton.danger:hover {
    background-color: #dc2626;
}

/* Success Button */
QPushButton#SuccessButton, QPushButton.success {
    background-color: var(--color-success);
    color: white;
    border: none;
}

QPushButton#SuccessButton:hover, QPushButton.success:hover {
    background-color: #16a34a;
}

/* Icon Button */
QPushButton.icon-button {
    min-width: 32px;
    min-height: 32px;
    padding: 6px;
    border-radius: var(--radius-md);
}

QPushButton.icon-button:only-child {
    margin: 0;
}

/* Small Button */
QPushButton.small {
    padding: 4px 12px;
    font-size: var(--font-size-xs);
}

/* Large Button */
QPushButton.large {
    padding: 12px 24px;
    font-size: var(--font-size-lg);
}

/* ==========================================================================
   INPUTS
   ========================================================================== */

QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: var(--color-bg-secondary);
    color: var(--color-text-primary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 10px 12px;
    font-size: var(--font-size-md);
    selection-background-color: var(--color-accent-muted);
    selection-color: var(--color-text-primary);
    outline: none;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px var(--color-accent-soft);
}

QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {
    opacity: 0.6;
    background-color: var(--color-bg-tertiary);
}

QLineEdit::placeholder, QTextEdit::placeholder, QPlainTextEdit::placeholder {
    color: var(--color-text-tertiary);
}

/* Search Input */
QLineEdit#SearchInput, QLineEdit.search-input {
    padding-left: 36px;
    background-image: url(:/icons/search.svg);
    background-repeat: no-repeat;
    background-position: 12px center;
    background-size: 16px 16px;
}

/* ==========================================================================
   COMBO BOX
   ========================================================================== */

QComboBox {
    background-color: var(--color-bg-secondary);
    color: var(--color-text-primary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 10px 12px;
    padding-right: 36px;
    font-size: var(--font-size-md);
    outline: none;
}

QComboBox:hover {
    border-color: var(--color-border-hover);
}

QComboBox:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px var(--color-accent-soft);
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right center;
    width: 24px;
    border: none;
    background-image: url(:/icons/chevron_down.svg);
    background-repeat: no-repeat;
    background-position: center;
}

QComboBox::down-arrow {
    width: 16px;
    height: 16px;
}

QComboBox QAbstractItemView {
    background-color: var(--color-bg-secondary);
    color: var(--color-text-primary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 4px;
    outline: none;
    selection-background-color: var(--color-accent);
    selection-color: white;
}

QComboBox QAbstractItemView::item {
    padding: 10px 12px;
    border-radius: var(--radius-sm);
    margin: 2px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: var(--color-bg-tertiary);
}

QComboBox QAbstractItemView::item:selected {
    background-color: var(--color-accent);
}

/* ==========================================================================
   SPIN BOX
   ========================================================================== */

QSpinBox, QDoubleSpinBox {
    background-color: var(--color-bg-secondary);
    color: var(--color-text-primary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 10px 12px;
    font-size: var(--font-size-md);
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px var(--color-accent-soft);
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 24px;
    border: none;
    background-color: transparent;
    image: url(:/icons/chevron_up.svg);
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 24px;
    border: none;
    background-color: transparent;
    image: url(:/icons/chevron_down.svg);
}

/* ==========================================================================
   CHECKBOX
   ========================================================================== */

QCheckBox {
    spacing: 8px;
    color: var(--color-text-primary);
    font-size: var(--font-size-md);
    min-height: 20px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid var(--color-border);
    border-radius: var(--radius-sm);
    background-color: transparent;
    transition: all var(--transition-fast);
}

QCheckBox::indicator:hover {
    border-color: var(--color-border-hover);
}

QCheckBox::indicator:checked {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
    image: url(:/icons/check.svg);
}

QCheckBox::indicator:checked:hover {
    background-color: var(--color-accent-hover);
}

QCheckBox::indicator:disabled {
    opacity: 0.5;
}

/* ==========================================================================
   RADIO BUTTON
   ========================================================================== */

QRadioButton {
    spacing: 8px;
    color: var(--color-text-primary);
    font-size: var(--font-size-md);
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid var(--color-border);
    border-radius: 9px;
    background-color: transparent;
}

QRadioButton::indicator:hover {
    border-color: var(--color-border-hover);
}

QRadioButton::indicator:checked {
    border-color: var(--color-accent);
    background-color: var(--color-accent);
}

QRadioButton::indicator:checked::after {
    content: "";
    position: absolute;
    top: 5px;
    left: 5px;
    width: 4px;
    height: 4px;
    border-radius: 4px;
    background-color: white;
}

/* ==========================================================================
   SLIDER
   ========================================================================== */

QSlider::groove:horizontal {
    height: 4px;
    background-color: var(--color-bg-tertiary);
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    margin: -6px 0;
    background-color: var(--color-accent);
    border-radius: 8px;
    cursor: pointer;
}

QSlider::handle:horizontal:hover {
    background-color: var(--color-accent-hover);
}

QSlider::sub-page:horizontal {
    background-color: var(--color-accent);
    border-radius: 2px;
}

/* ==========================================================================
   SCROLL BAR
   ========================================================================== */

QScrollBar:vertical {
    background-color: transparent;
    width: 10px;
    border-radius: 5px;
    margin: 0;
    padding: 4px 2px;
}

QScrollBar::handle:vertical {
    background-color: var(--color-bg-active);
    min-height: 30px;
    border-radius: 4px;
    margin: 2px;
    transition: background-color var(--transition-fast);
}

QScrollBar::handle:vertical:hover {
    background-color: var(--color-text-tertiary);
}

QScrollBar::handle:vertical:pressed {
    background-color: var(--color-text-secondary);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
    border: none;
    background: none;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 10px;
    border-radius: 5px;
    margin: 0;
    padding: 2px 4px;
}

QScrollBar::handle:horizontal {
    background-color: var(--color-bg-active);
    min-width: 30px;
    border-radius: 4px;
    margin: 2px;
    transition: background-color var(--transition-fast);
}

QScrollBar::handle:horizontal:hover {
    background-color: var(--color-text-tertiary);
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
    border: none;
    background: none;
}

/* ==========================================================================
   MENU BAR & MENUS
   ========================================================================== */

QMenuBar {
    background-color: var(--color-bg-secondary);
    color: var(--color-text-primary);
    border-bottom: 1px solid var(--color-border);
    padding: 6px 12px;
    font-size: var(--font-size-md);
}

QMenuBar::item {
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    background-color: transparent;
}

QMenuBar::item:selected {
    background-color: var(--color-bg-tertiary);
}

QMenuBar::item:pressed {
    background-color: var(--color-bg-hover);
}

QMenu {
    background-color: var(--color-bg-secondary);
    color: var(--color-text-primary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 6px;
    box-shadow: var(--shadow-lg);
}

QMenu::item {
    padding: 10px 16px;
    border-radius: var(--radius-sm);
    font-size: var(--font-size-md);
}

QMenu::item:selected {
    background-color: var(--color-bg-tertiary);
    color: var(--color-text-primary);
}

QMenu::item:checked {
    color: var(--color-accent);
}

QMenu::separator {
    height: 1px;
    background-color: var(--color-border);
    margin: 6px 0;
}

QMenu::icon {
    padding-left: 4px;
}

QMenu::indicator {
    width: 16px;
    height: 16px;
    padding-right: 4px;
}

/* ==========================================================================
   TOOLBAR
   ========================================================================== */

QToolBar {
    background-color: var(--color-bg-secondary);
    border-bottom: 1px solid var(--color-border);
    padding: 6px;
    spacing: 4px;
}

QToolBar::separator {
    width: 1px;
    background-color: var(--color-border);
    margin: 4px 8px;
}

QToolButton {
    background-color: transparent;
    color: var(--color-text-primary);
    border: none;
    border-radius: var(--radius-md);
    padding: 6px 10px;
    font-size: var(--font-size-sm);
}

QToolButton:hover {
    background-color: var(--color-bg-tertiary);
}

QToolButton:checked, QToolButton:pressed {
    background-color: var(--color-bg-hover);
}

/* ==========================================================================
   TABS
   ========================================================================== */

QTabWidget::pane {
    background-color: var(--color-bg-primary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    top: -1px;
}

QTabBar::tab {
    background-color: transparent;
    color: var(--color-text-secondary);
    border: none;
    border-bottom: 2px solid transparent;
    padding: 12px 20px;
    font-size: var(--font-size-md);
    min-width: 80px;
    margin-right: 2px;
}

QTabBar::tab:hover {
    color: var(--color-text-primary);
    background-color: var(--color-bg-secondary);
}

QTabBar::tab:selected {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
    background-color: var(--color-bg-secondary);
}

QTabBar::tab:close-button {
    image: url(:/icons/close.svg);
    width: 14px;
    height: 14px;
    padding: 2px;
    border-radius: var(--radius-sm);
}

QTabBar::tab:close-button:hover {
    background-color: var(--color-bg-tertiary);
}

/* ==========================================================================
   TABLE WIDGET
   ========================================================================== */

QTableWidget {
    background-color: var(--color-bg-secondary);
    color: var(--color-text-primary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    gridline-color: var(--color-border);
    selection-background-color: var(--color-accent-muted);
    selection-color: var(--color-text-primary);
    outline: none;
}

QTableWidget::item {
    padding: 10px 12px;
    border: none;
    border-bottom: 1px solid var(--color-border);
}

QTableWidget::item:selected {
    background-color: var(--color-accent-muted);
}

QTableWidget::item:hover {
    background-color: var(--color-bg-tertiary);
}

/* Alternating row colors */
QTableWidget[alternatingRowColors="true"]::item:nth-child(even) {
    background-color: rgba(255, 255, 255, 0.02);
}

QHeaderView::section {
    background-color: var(--color-bg-tertiary);
    color: var(--color-text-secondary);
    padding: 12px 16px;
    border: none;
    border-bottom: 1px solid var(--color-border);
    font-weight: 500;
    font-size: var(--font-size-sm);
}

QHeaderView::section:hover {
    background-color: var(--color-bg-hover);
}

QHeaderView::section:checked {
    color: var(--color-accent);
}

QHeaderView::down-arrow {
    image: url(:/icons/chevron_down.svg);
    width: 14px;
    height: 14px;
}

QHeaderView::up-arrow {
    image: url(:/icons/chevron_up.svg);
    width: 14px;
    height: 14px;
}

QTableWidget QTableCornerButton::section {
    background-color: var(--color-bg-tertiary);
    border: none;
}

/* ==========================================================================
   TREE VIEW
   ========================================================================== */

QTreeView {
    background-color: transparent;
    color: var(--color-text-primary);
    border: none;
    outline: none;
    font-size: var(--font-size-md);
}

QTreeView::item {
    padding: 8px 12px;
    border-radius: var(--radius-md);
    margin: 2px 0;
}

QTreeView::item:hover {
    background-color: var(--color-bg-tertiary);
}

QTreeView::item:selected {
    background-color: var(--color-accent-muted);
    color: var(--color-accent);
}

QTreeView::branch {
    background-color: transparent;
}

QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    image: url(:/icons/chevron_right.svg);
    width: 16px;
    height: 16px;
}

QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    image: url(:/icons/chevron_down.svg);
    width: 16px;
    height: 16px;
}

/* ==========================================================================
   LIST WIDGET
   ========================================================================== */

QListWidget {
    background-color: transparent;
    color: var(--color-text-primary);
    border: none;
    outline: none;
    padding: 4px;
}

QListWidget::item {
    padding: 12px 16px;
    border-radius: var(--radius-md);
    margin: 4px 0;
    background-color: var(--color-bg-secondary);
    border: 1px solid transparent;
}

QListWidget::item:hover {
    background-color: var(--color-bg-tertiary);
    border-color: var(--color-border);
}

QListWidget::item:selected {
    background-color: var(--color-accent);
    color: white;
    border-color: var(--color-accent);
}

/* ==========================================================================
   FRAMES & CARDS
   ========================================================================== */

QFrame {
    border: none;
}

QFrame.Card, .card {
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
}

QFrame.Card:hover, .card:hover {
    border-color: var(--color-border-hover);
}

QFrame.CardFlat, .card-flat {
    background-color: var(--color-bg-secondary);
    border-radius: var(--radius-lg);
}

QFrame.Section, .section {
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--spacing-lg);
}

/* ==========================================================================
   GROUP BOX
   ========================================================================== */

QGroupBox {
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    margin-top: var(--spacing-lg);
    padding-top: var(--spacing-lg);
    font-size: var(--font-size-md);
    font-weight: 500;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: var(--spacing-lg);
    padding: 0 var(--spacing-sm);
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    font-weight: 500;
}

/* ==========================================================================
   PROGRESS BAR
   ========================================================================== */

QProgressBar {
    background-color: var(--color-bg-tertiary);
    border: none;
    border-radius: var(--radius-md);
    height: 8px;
    text-align: center;
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
}

QProgressBar::chunk {
    background-color: var(--color-accent);
    border-radius: var(--radius-md);
}

QProgressBar.success::chunk {
    background-color: var(--color-success);
}

QProgressBar.warning::chunk {
    background-color: var(--color-warning);
}

QProgressBar.danger::chunk {
    background-color: var(--color-danger);
}

/* ==========================================================================
   DIALOGS
   ========================================================================== */

QDialog {
    background-color: var(--color-bg-primary);
}

QDialog#ModalDialog, .modal-dialog {
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-xl);
}

QDialogButtonBox {
    background-color: transparent;
    border: none;
}

QDialogButtonBox QPushButton {
    min-width: 80px;
}

/* ==========================================================================
   SPLITTER
   ========================================================================== */

QSplitter {
    background-color: transparent;
    border: none;
}

QSplitter::handle {
    background-color: var(--color-border);
}

QSplitter::handle:horizontal {
    width: 4px;
    margin: 4px 0;
    border-radius: 2px;
}

QSplitter::handle:vertical {
    height: 4px;
    margin: 0 4px;
    border-radius: 2px;
}

QSplitter::handle:hover {
    background-color: var(--color-accent);
}

/* ==========================================================================
   STATUS BAR
   ========================================================================== */

QStatusBar {
    background-color: var(--color-bg-secondary);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    padding: 6px 12px;
    font-size: var(--font-size-sm);
}

QStatusBar::item {
    border: none;
}

/* ==========================================================================
   TOOLTIP
   ========================================================================== */

QToolTip {
    background-color: var(--color-bg-tertiary);
    color: var(--color-text-primary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 8px 12px;
    font-size: var(--font-size-sm);
    box-shadow: var(--shadow-lg);
}

/* ==========================================================================
   TOAST NOTIFICATIONS
   ========================================================================== */

#ToastWidget, .toast {
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--spacing-md);
    box-shadow: var(--shadow-xl);
}

#ToastWidget.success, .toast.success {
    border-left: 4px solid var(--color-success);
}

#ToastWidget.warning, .toast.warning {
    border-left: 4px solid var(--color-warning);
}

#ToastWidget.error, .toast.error {
    border-left: 4px solid var(--color-danger);
}

#ToastWidget.info, .toast.info {
    border-left: 4px solid var(--color-info);
}

/* ==========================================================================
   BADGES & TAGS
   ========================================================================== */

QLabel#Badge, .badge {
    background-color: var(--color-bg-tertiary);
    color: var(--color-text-secondary);
    border-radius: var(--radius-xl);
    padding: 4px 10px;
    font-size: var(--font-size-xs);
    font-weight: 500;
}

QLabel#BadgePrimary, .badge-primary {
    background-color: var(--color-accent-muted);
    color: var(--color-accent);
}

QLabel#BadgeSuccess, .badge-success {
    background-color: var(--color-success-soft);
    color: var(--color-success);
}

QLabel#BadgeWarning, .badge-warning {
    background-color: var(--color-warning-soft);
    color: var(--color-warning);
}

QLabel#BadgeDanger, .badge-danger {
    background-color: var(--color-danger-soft);
    color: var(--color-danger);
}

/* ==========================================================================
   LOADING INDICATORS
   ========================================================================== */

QProgressBar#LoadingBar, .loading-bar {
    background-color: transparent;
    border: none;
    height: 4px;
}

QProgressBar#LoadingBar::chunk, .loading-bar::chunk {
    background-color: var(--color-accent);
    width: 20%;
    animation: loading 1.5s infinite;
}

@keyframes loading {
    0% { margin-left: 0%; width: 20%; }
    50% { margin-left: 60%; width: 20%; }
    100% { margin-left: 100%; width: 0%; }
}

/* ==========================================================================
   EMPTY STATES
   ========================================================================== */

QLabel#EmptyState, .empty-state {
    color: var(--color-text-tertiary);
    font-size: var(--font-size-md);
    padding: var(--spacing-xl);
}

/* ==========================================================================
   HOVER EFFECTS
   ========================================================================== */

HoverableWidget:hover, .hoverable:hover {
    background-color: var(--color-bg-tertiary);
}

/* ==========================================================================
   ANIMATIONS
   ========================================================================== */

AnimatedWidget {
    transition: all var(--transition-normal);
}

/* ==========================================================================
   SIDEBAR SPECIFIC
   ========================================================================== */

#Sidebar {
    background-color: var(--color-bg-secondary);
    border-right: 1px solid var(--color-border);
}

#SidebarHeader {
    background-color: var(--color-bg-tertiary);
    border-bottom: 1px solid var(--color-border);
    padding: var(--spacing-md);
}

#SidebarTitle {
    color: var(--color-text-primary);
    font-weight: 600;
    font-size: var(--font-size-sm);
    letter-spacing: 0.5px;
    text-transform: uppercase;
}

#SidebarSearch {
    padding: var(--spacing-sm) var(--spacing-md);
    background-color: var(--color-bg-primary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    margin: var(--spacing-sm);
}

#SidebarSearch:focus {
    border-color: var(--color-accent);
}

#SidebarTree {
    background-color: transparent;
    border: none;
}

#SidebarTree::item {
    padding: 8px 12px;
    border-radius: var(--radius-md);
    margin: 2px 4px;
}

#SidebarTree::item:hover {
    background-color: var(--color-bg-tertiary);
}

#SidebarTree::item:selected {
    background-color: var(--color-accent-muted);
    color: var(--color-accent);
}

#AddSidebarItemButton {
    background-color: transparent;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-tertiary);
    padding: var(--spacing-sm);
    font-size: var(--font-size-sm);
}

#AddSidebarItemButton:hover {
    background-color: var(--color-bg-tertiary);
    border-color: var(--color-accent);
    color: var(--color-accent);
}

/* ==========================================================================
   STEPS PANEL (Transformation Pipeline)
   ========================================================================== */

#StepsPanel {
    background-color: var(--color-bg-secondary);
    border-right: 1px solid var(--color-border);
}

#StepsHeader {
    padding: var(--spacing-md);
    border-bottom: 1px solid var(--color-border);
}

#StepsTitle {
    color: var(--color-text-primary);
    font-weight: 600;
    font-size: var(--font-size-lg);
}

#StepsList {
    background-color: transparent;
    border: none;
    padding: var(--spacing-sm);
}

#StepsList::item {
    background-color: var(--color-bg-primary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--spacing-md);
    margin-bottom: var(--spacing-sm);
}

#StepsList::item:hover {
    border-color: var(--color-border-hover);
}

#StepsList::item:selected {
    border-color: var(--color-accent);
    background-color: var(--color-accent-muted);
}

#StepToggle {
    min-width: 40px;
}

#StepName {
    font-weight: 500;
    color: var(--color-text-primary);
}

#StepDescription {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
}

#StepType {
    font-size: var(--font-size-xs);
    color: var(--color-text-tertiary);
    padding: 2px 6px;
    background-color: var(--color-bg-tertiary);
    border-radius: var(--radius-sm);
}

/* ==========================================================================
   DATA PREVIEW
   ========================================================================== */

#DataPreviewContainer {
    background-color: var(--color-bg-primary);
    border-radius: var(--radius-lg);
    overflow: hidden;
}

#DataPreviewHeader {
    background-color: var(--color-bg-secondary);
    border-bottom: 1px solid var(--color-border);
    padding: var(--spacing-md);
}

#RowCountLabel {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
}

/* ==========================================================================
   FORM LAYOUT
   ========================================================================== */

FormLabel, .form-label {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    padding-bottom: var(--spacing-xs);
}

FormLabel[required="true"]::after {
    content: " *";
    color: var(--color-danger);
}

/* ==========================================================================
   DIVIDERS
   ========================================================================== */

QFrame#Divider, .divider {
    background-color: var(--color-border);
    min-height: 1px;
    max-height: 1px;
}

QFrame#VerticalDivider, .vertical-divider {
    background-color: var(--color-border);
    min-width: 1px;
    max-width: 1px;
}

/* ==========================================================================
   CONTEXT MENU
   ========================================================================== */

QMenu#ContextMenu, .context-menu {
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 6px;
    box-shadow: var(--shadow-lg);
}

QMenu#ContextMenu::item, .context-menu::item {
    padding: 10px 16px;
    border-radius: var(--radius-sm);
}

QMenu#ContextMenu::item:hover, .context-menu::item:hover {
    background-color: var(--color-bg-tertiary);
}

QMenu#ContextMenu::separator, .context-menu::separator {
    margin: 4px 0;
}

QMenu#ContextMenu SubmenuIndicator, .context-menu .submenu-indicator {
    right: 8px;
}

/* ==========================================================================
   SCROLL AREA
   ========================================================================== */

QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QScrollArea > QWidget {
    background-color: transparent;
}

/* ==========================================================================
   DASHBOARD CARDS
   ========================================================================== */

#DashboardCard, .dashboard-card {
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--spacing-lg);
}

#DashboardCard:hover, .dashboard-card:hover {
    border-color: var(--color-border-hover);
    box-shadow: var(--shadow-md);
}

#DashboardCardTitle {
    font-size: var(--font-size-lg);
    font-weight: 600;
    color: var(--color-text-primary);
}

#DashboardCardValue {
    font-size: 28px;
    font-weight: 700;
    color: var(--color-accent);
}

#DashboardCardDescription {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
}

/* ==========================================================================
   WELCOME SCREEN
   ========================================================================== */

#WelcomeContainer {
    background: qlineargradient(
        x1: 0%, y1: 0%, x2: 100%, y2: 100%,
        stop: 0% var(--color-bg-secondary),
        stop: 100% var(--color-bg-primary)
    );
    border-radius: var(--radius-xl);
    padding: var(--spacing-xl);
}

#WelcomeTitle {
    font-size: 28px;
    font-weight: 700;
    color: var(--color-text-primary);
}

#WelcomeSubtitle {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
}

#WelcomeActionButton {
    background-color: var(--color-accent);
    color: white;
    border: none;
    border-radius: var(--radius-md);
    padding: 12px 24px;
    font-size: var(--font-size-md);
    font-weight: 500;
}

#WelcomeActionButton:hover {
    background-color: var(--color-accent-hover);
}

/* ==========================================================================
   KEYBOARD FOCUS RING (ACCESSIBILITY)
   ========================================================================== */

*:focus {
    outline: none;
}

*:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
}

/* ==========================================================================
   HIGHLIGHT COLORS FOR SPECIFIC WIDGETS
   ========================================================================== */

/* Info Panel */
#InfoPanel {
    background-color: var(--color-info-soft);
    border-left: 3px solid var(--color-info);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    padding: var(--spacing-md);
}

/* Success Panel */
#SuccessPanel {
    background-color: var(--color-success-soft);
    border-left: 3px solid var(--color-success);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    padding: var(--spacing-md);
}

/* Warning Panel */
#WarningPanel {
    background-color: var(--color-warning-soft);
    border-left: 3px solid var(--color-warning);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    padding: var(--spacing-md);
}

/* Error Panel */
#ErrorPanel {
    background-color: var(--color-danger-soft);
    border-left: 3px solid var(--color-danger);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    padding: var(--spacing-md);
}

/* ==========================================================================
   CUSTOM SCROLL AREA FOR DATA TABLES
   ========================================================================== */

DataTableScrollArea {
    background-color: var(--color-bg-secondary);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
}

DataTableScrollArea QTableWidget {
    border: none;
    border-radius: 0;
}

/* ==========================================================================
   TRANSFORMATION BUTTON
   ========================================================================== */

#TransformButton {
    background-color: var(--color-accent);
    color: white;
    border: none;
    border-radius: var(--radius-md);
    padding: 10px 20px;
    font-weight: 500;
}

#TransformButton:hover {
    background-color: var(--color-accent-hover);
}

/* ==========================================================================
   FILTER ROW
   ========================================================================== */

#FilterRow {
    background-color: var(--color-bg-tertiary);
    border-bottom: 1px solid var(--color-border);
    padding: var(--spacing-sm) var(--spacing-md);
}

#FilterInput {
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 6px 10px;
}

/* ==========================================================================
   END OF STYLESHEET
   ========================================================================== */

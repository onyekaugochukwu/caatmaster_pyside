/*
 * CAATmaster Light Theme with Dark Sidebar - V2
 * A professional, modern theme with light mode everywhere except sidebar.
 */

/* --- Global Settings --- */
QWidget {
    background-color: #ffffff; /* Light main background */
    color: #333333; /* Dark text */
    font-family: "Segoe UI", "Cantarell", "Fira Sans", "Droid Sans", "Helvetica Neue", sans-serif;
    font-size: 10pt;
    border: none;
}

/* --- Main Window & Core Layout --- */
QMainWindow {
    background-color: #ffffff;
}

#PreviewPanel, #StepsPanel {
    background-color: #f5f5f5;
    padding: 10px;
}

/* --- Menu Bar & Menus --- */
QMenuBar {
    background-color: #f8f8f8;
    color: #333333;
    padding: 5px;
}
QMenuBar::item {
    background-color: transparent;
    padding: 5px 10px;
    border-radius: 4px;
}
QMenuBar::item:selected {
    background-color: #007acc;
    color: #ffffff;
}
QMenu {
    background-color: #ffffff;
    color: #333333;
    border: 1px solid #e0e0e0;
    padding: 5px;
}
QMenu::item {
    padding: 8px 20px;
}
QMenu::item:selected {
    background-color: #007acc;
    color: #ffffff;
}
QMenu::separator {
    height: 1px;
    background-color: #e0e0e0;
    margin: 5px;
}

/* --- Sidebar --- */
#Sidebar {
    background-color: #0f172a; /* Match sidebar inline style */
    border-right: 1px solid #1e293b;
}

#SidebarHeader {
    background-color: #1e293b;
    border-bottom: 1px solid #1e293b;
}

#SidebarTitle {
    color: #cccccc;
    font-weight: bold;
    font-size: 9pt;
    letter-spacing: 1px;
}

#AddProjectButton {
    background-color: transparent;
    color: #cccccc;
    border: 1px solid #4f4f4f;
    border-radius: 12px;
    font-size: 12pt;
    font-weight: bold;
}
#AddProjectButton:hover {
    background-color: #007acc;
    border-color: #007acc;
    color: #ffffff;
}

#Sidebar QTreeView {
    background-color: transparent;
    border: none;
    padding: 5px;
}
QTreeView::item {
    padding: 8px 5px;
    border-radius: 4px;
}
QTreeView::item:hover {
    background-color: #1f2937; /* Match sidebar hover color */
}
QTreeView::item:selected {
    background-color: #1e3a8a; /* Match sidebar selected color */
    color: #ffffff;
}
QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    image: url(src/resources/icons/chevron_right.svg);
}
QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    image: url(src/resources/icons/chevron_down.svg);
}

/* --- Transform View --- */
#StepsPanel {
    background-color: #f5f5f5;
    border-right: 1px solid #e0e0e0;
}

#StepsTitle {
    color: #333333;
    font-weight: bold;
    font-size: 9pt;
    letter-spacing: 1px;
    padding-bottom: 10px;
    border-bottom: 1px solid #e0e0e0;
}

#StepsHeader {
    background-color: #f5f5f5;
    border-bottom: 1px solid #e0e0e0;
}

#PrimaryButton {
    background-color: #007acc;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 6px 12px;
    font-weight: 500;
}

#PrimaryButton:hover {
    background-color: #106ebe;
}

#SecondaryButton {
    background-color: #f8f8f8;
    color: #333333;
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    padding: 6px 12px;
    font-weight: 500;
}

#SecondaryButton:hover {
    background-color: #e0e0e0;
}

#StepsList {
    background-color: transparent;
    border: none;
}

#StepsList::item {
    color: #333333;
    padding: 8px;
    border-radius: 4px;
}
#StepsList::item:hover {
    background-color: #e0e0e0;
}
#StepsList::item:selected {
    background-color: #007acc;
    color: #ffffff;
}

/* --- Data Table --- */
QTableWidget {
    background-color: #ffffff;
    gridline-color: #e0e0e0;
    selection-background-color: #007acc;
    selection-color: #ffffff;
    border: none;
}
QTableWidget::item {
    padding: 5px;
    border: none;
    color: #333333;
}
QHeaderView::section {
    background-color: #f8f8f8;
    color: #333333;
    padding: 8px;
    border: none;
    border-bottom: 1px solid #e0e0e0;
    font-weight: bold;
}
QTableWidget::horizontalHeader {
    border: none;
}
QTableWidget::verticalHeader {
    border: none;
}


/* --- Other Controls --- */
QPushButton {
    background-color: #007acc;
    color: #ffffff;
    border: none;
    padding: 8px 16px;
    border-radius: 4px;
}
QPushButton:hover {
    background-color: #108ddc;
}
QPushButton:disabled {
    background-color: #cccccc;
    color: #666666;
}

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #ffffff;
    color: #333333;
    border: 1px solid #cccccc;
    border-radius: 4px;
    padding: 5px;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-color: #007acc;
}

QDialog {
    background-color: #ffffff;
}

QSplitter::handle {
    background-color: #e0e0e0;
}
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 1px; }

QStatusBar {
    background-color: #f8f8f8;
    color: #333333;
    border-top: 1px solid #e0e0e0;
}

QLabel#info_label {
    padding: 10px;
    background-color: #f8f8f8;
    color: #666666;
}

/* ===== Additional Widget Styles (from default.qss) ===== */

/* QTabWidget */
QTabWidget::pane {
    border: 1px solid #e0e0e0;
    background: white;
}

QTabBar::tab {
    background: #f0f0f0;
    padding: 8px 16px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background: white;
    border-bottom: 2px solid #0078d4;
}

QTabBar::tab:hover {
    background: #e8e8e8;
}

/* QGroupBox */
QGroupBox {
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    margin-top: 12px;
    padding: 12px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
}

/* QScrollBar */
QScrollBar:vertical {
    border: none;
    background: #f0f0f0;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #cccccc;
    min-height: 30px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background: #999999;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    border: none;
    background: #f0f0f0;
    height: 12px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #cccccc;
    min-width: 30px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background: #999999;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* QToolBar */
QToolBar {
    background: #f8f8f8;
    border: none;
    spacing: 4px;
    padding: 4px;
}

QToolBar::separator {
    width: 1px;
    background: #e0e0e0;
    margin: 4px 8px;
}

/* QProgressBar */
QProgressBar {
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    background: #f0f0f0;
    text-align: center;
}

QProgressBar::chunk {
    background: #0078d4;
    border-radius: 3px;
}

/* QCheckBox */
QCheckBox {
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #cccccc;
    border-radius: 3px;
    background: white;
}

QCheckBox::indicator:checked {
    background: #0078d4;
    border-color: #0078d4;
    image: url(:/icons/checkmark.png);
}

/* QFrame */
QFrame {
    border: none;
}

QFrame[frameShape="4"], QFrame[frameShape="5"] { /* HLine, VLine */
    color: #e0e0e0;
}

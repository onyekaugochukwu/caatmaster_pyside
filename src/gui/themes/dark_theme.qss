/*
 * CAATmaster Dark Theme - V2
 * A professional, modern theme inspired by VS Code.
 */

/* --- Global Settings --- */
QWidget {
    background-color: #1e1e1e; /* A darker main background */
    color: #d4d4d4;
    font-family: "Segoe UI", "Cantarell", "Fira Sans", "Droid Sans", "Helvetica Neue", sans-serif;
    font-size: 10pt;
    border: none;
}

/* --- Main Window & Core Layout --- */
QMainWindow {
    background-color: #1e1e1e;
}

#PreviewPanel, #StepsPanel {
    background-color: #252526;
    padding: 10px;
}

/* --- Menu Bar & Menus --- */
QMenuBar {
    background-color: #333333;
    color: #cccccc;
    padding: 5px;
}
QMenuBar::item {
    background-color: transparent;
    padding: 5px 10px;
    border-radius: 4px;
}
QMenuBar::item:selected {
    background-color: #007acc;
    color: #ffffff;
}
QMenu {
    background-color: #252526;
    color: #cccccc;
    border: 1px solid #3c3c3c;
    padding: 5px;
}
QMenu::item {
    padding: 8px 20px;
}
QMenu::item:selected {
    background-color: #007acc;
}
QMenu::separator {
    height: 1px;
    background-color: #3c3c3c;
    margin: 5px;
}

/* --- Sidebar --- */
#Sidebar {
    background-color: #252526;
    border-right: 1px solid #3c3c3c;
}

#SidebarHeader {
    background-color: #333333;
    border-bottom: 1px solid #3c3c3c;
}

#SidebarTitle {
    color: #cccccc;
    font-weight: bold;
    font-size: 9pt;
    letter-spacing: 1px;
}

#AddProjectButton {
    background-color: transparent;
    color: #cccccc;
    border: 1px solid #4f4f4f;
    border-radius: 12px;
    font-size: 12pt;
    font-weight: bold;
}
#AddProjectButton:hover {
    background-color: #007acc;
    border-color: #007acc;
    color: #ffffff;
}

#Sidebar QTreeView {
    background-color: transparent;
    border: none;
    padding: 5px;
}
QTreeView::item {
    padding: 8px 5px;
    border-radius: 4px;
}
QTreeView::item:hover {
    background-color: #2a2d2e;
}
QTreeView::item:selected {
    background-color: #094771;
    color: #ffffff;
}
QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    image: url(src/resources/icons/chevron_right.svg);
}
QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    image: url(src/resources/icons/chevron_down.svg);
}

/* --- Transform View --- */
#StepsPanel {
    background-color: #1e1e1e;
    border-right: 1px solid #3c3c3c;
}

#StepsTitle {
    color: #cccccc;
    font-weight: bold;
    font-size: 9pt;
    letter-spacing: 1px;
    padding-bottom: 10px;
    border-bottom: 1px solid #3c3c3c;
}

#StepsList {
    background-color: transparent;
    border: none;
}

#StepsList::item {
    color: #d4d4d4;
    padding: 8px;
    border-radius: 4px;
}
#StepsList::item:hover {
    background-color: #2a2d2e;
}
#StepsList::item:selected {
    background-color: #094771;
}

/* --- Data Table --- */
QTableWidget {
    background-color: #252526;
    gridline-color: #3c3c3c;
    selection-background-color: #094771;
    border: none;
}
QTableWidget::item {
    padding: 5px;
    border: none;
}
QHeaderView::section {
    background-color: #1e1e1e;
    color: #d4d4d4;
    padding: 8px;
    border: none;
    border-bottom: 1px solid #3c3c3c;
    font-weight: bold;
}
QTableWidget::horizontalHeader {
    border: none;
}
QTableWidget::verticalHeader {
    border: none;
}


/* --- Other Controls --- */
QPushButton {
    background-color: #007acc;
    color: #ffffff;
    border: none;
    padding: 8px 16px;
    border-radius: 4px;
}
QPushButton:hover {
    background-color: #108ddc;
}
QPushButton:disabled {
    background-color: #2a2d2e;
    color: #666666;
}

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #3c3c3c;
    color: #d4d4d4;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    padding: 5px;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-color: #007acc;
}

QDialog {
    background-color: #252526;
}

QSplitter::handle {
    background-color: #3c3c3c;
}
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 1px; }

QStatusBar {
    background-color: #007acc;
    color: #ffffff;
}

QLabel#info_label {
    padding: 10px;
    background-color: #252526;
    color: #9e9e9e;
}
